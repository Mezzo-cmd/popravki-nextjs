# ── Supabase ──
# Намери тези стойности в: supabase.com → твоят проект → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ТВОЯТ_ПРОЕКТ.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=твоят_anon_key

# Само за server-side операции (Admin панел)
SUPABASE_SERVICE_ROLE_KEY=твоят_service_role_key

# Admin email(s) — разделени със запетая
ADMIN_EMAILS=admin@popravki.bg
